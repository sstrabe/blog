{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "marked": "18.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
